# ---------------------------------------------------------------- 运行环境
APP_ENV=development
APP_NAME=老村记忆

# 生产环境必须替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------- 存储
# SQLite 默认放在 api/ 目录下；迁移 PostgreSQL 时改成
# postgresql+asyncpg://user:pass@127.0.0.1:5432/village
DATABASE_URL=sqlite+aiosqlite:///./village.db
MEDIA_ROOT=./media
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 前端域名，逗号分隔；Vercel 预览域名可加通配前缀
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- 初始管理员
ADMIN_INIT_EMAIL=admin@village.local
ADMIN_INIT_PASSWORD=Village@2026
ADMIN_INIT_NICKNAME=村长

# ---------------------------------------------------------------- 上传限制
MAX_IMAGE_MB=20
MAX_VIDEO_MB=500
MAX_FILE_MB=100
USER_STORAGE_QUOTA_GB=5

# ---------------------------------------------------------------- 视频转码
# Windows 上填 ffmpeg.exe 的绝对路径，或确保它在 PATH 里
FFMPEG_PATH=ffmpeg
VIDEO_TRANSCODE_ENABLED=true

LOG_LEVEL=INFO
